# Copy to .env and replace placeholders with local credentials. Never commit .env.
DATABASE_URL=postgresql+psycopg://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:55432/accessforge_test
LOG_LEVEL=INFO
# Integration tests are opt-in; use only a disposable database named *_test.
# TEST_DATABASE_URL=postgresql+psycopg://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:55432/accessforge_test
# compose.test.yaml requires a throwaway password supplied by the operator.
# POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_TEST_PASSWORD
# Reviewer access. One "reviewer-uuid:sha256-hex-of-key" pair per reviewer, comma-separated.
# Create a key:    openssl rand -hex 32
# Hash the key:    printf '%s' "$KEY" | shasum -a 256
# Reviewer UUID:   uuidgen | tr A-Z a-z
# Leave empty to disable every review action. Never store the raw key here.
REVIEWER_KEYS=
# Set to false only for local HTTP development in browsers that drop Secure cookies.
# REVIEWER_COOKIE_SECURE=true
